*******************************************************************************
* LAB #4
* The Short Circuits
* - Bangco, Phoebe Hannah
* - Linchangco, Ricki Rose
* - Maranan, Erin Clare
*******************************************************************************

.include "8clocks.jsim"
.include "nominal.jsim"
.include "stdcell.jsim"

*******************************************************************************
* The fa and add32 subcircuits are copied from lab3.jsim. 
* The fa subcircuit is a full-adder that takes three single-bit inputs (a, b, 
*   and c_in) and produces a single-bit sum and carry_out.
* The add32 subcircuit is a 32-bit ripple-carry adder that uses 32 instances of
*   the fa subcircuit to add two 32-bit numbers along with an initial carry-in.
*******************************************************************************
.subckt fa a b c_in sum c_out
    Xxor1 a b axorb xor2
    Xxor2 axorb c_in sum xor2
    Xnand1 a b term1 nand2
    Xnand2 c_in axorb term2 nand2
    Xnand3 term1 term2 c_out nand2
.ends

.subckt add32 a[31:0] b[31:0] cin0 sum[31:0] cout[31:30]
  Xbit a[31:0] b[31:0] cout[30:0] cin0 sum[31:0] cout[31:0] fa
.ends

*******************************************************************************
* The counter32 subcircuit uses the add32 subcircuit to increment the stored 
*   value by the increment value (input a).
* It also uses a 32-bit multiplexer to select between the incremented value 
*   (when reset = 0) and a reset value (when reset = 1). 
* The selected value is then stored in a 32-bit D flip-flop register on every 
*   positive clock edge.
*******************************************************************************

.subckt counter32 reset a[31:0] f[31:0] clk
  *ADD32
  Xfa a[31:0] f[31:0] 0 sum[31:0] c31 c30 add32

  *MULTIPLEXER
  Xmux reset#32 sum[31:0] d1[31:0] z[31:0] mux2

  *D REGISTER
  Xdreg z[31:0] clk#32 f[31:0] dreg

  .connect 0 d1[31:0]

.ends

*******************************************************************************
* Finally, it's time to simulate.
* This circuit block instantiates the counter32 circuit that you just wrote.
* We pass it a single-bit reset signal, a 32-bit increment value, a 32-bit
* register, and a clock signal (we just used the JSim-predefined clk1).
*******************************************************************************
Xcounter32 reset incr[31:0] reg[31:0] clk1 counter32

*******************************************************************************
* This "reset" waveform sets up a reset signal that has a delayed start
* and then goes to the next value every 50ns.
* The values "1 0 0 0 1 0" indicate that the reset signal only turns on twice.
* (But at which times?)
*******************************************************************************
Wreset reset nrz(0, 5, 50ns, 14.8ns, 0.001ns, 0.001ns)
+ 1 0 0 0 1 0

*******************************************************************************
* This "incr" waveform sets up a increment value for your counter32 circuit.
* Note that it does NOT have a delayed start. The values "0 1 3 -1" roughly
* translate to the following "commands" in Java-like syntax:
*   reg += 0;  //  0 means don't touch the value
*   reg++;     //  1 means increment by 1
*   reg += 3;  //  3 means increment by 3
*   reg--;     // -1 means decrement by 1
* But note that these "commands" will happen EVERY positive clock edge (and
* only when your reset signal is off)!
*******************************************************************************
Wincr incr[31:0] nrz(0, 5, 50ns, 0ns, 0.001ns, 0.001ns)
+ 0 1 3 -1

*******************************************************************************
* Plot our reset waveform, our incr waveform, clk1, and your 32-bit register.
* Note: sd() displays a range of nodes as a signed decimal (instead of hex)
*******************************************************************************
.tran 300ns
.plot reset
.plot sd(incr[31:0])
.plot clk1
.plot sd(reg[31:0])
